{
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage", "storybook-static", "*.tgz"],
  "overrides": [
    {
      "files": ["src/headless/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react/*"],
                "message": "headless 层禁止任何框架依赖"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/render/colors.ts",
        "src/adapters/otlp.ts",
        "src/headless/interaction/selectors.ts",
        "test/i18n.test.ts"
      ],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off"
      }
    }
  ]
}
